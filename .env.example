# Application runtime. Accepted values: development, production.
NODE_ENV=development

# PostgreSQL connection URL. This default matches docker-compose.yaml.
DATABASE_URL=postgresql://shinro:shinro@localhost:5432/shinro

# Redis connection URL. This default matches docker-compose.yaml.
REDIS_URL=redis://:shinro@localhost:6379

# Optional: force the session cookie Secure flag (true/false).
# Leave empty to follow the request protocol, including X-Forwarded-Proto behind a trusted reverse proxy.
COOKIE_SECURE=

# Optional: session lifetime in days (integer, 1-365). Sessions are not extended by activity.
SESSION_LIFETIME_DAYS=10

# Required when NUXT_PUBLIC_ENABLE_MOVIES=true: TMDb API Read Access Token (v4 bearer token), not a v3 API key.
TMDB_TOKEN=

# Required when NUXT_PUBLIC_ENABLE_MOVIES=true: TMDb response language in ISO 639-1 form, optionally with an ISO 3166-1 region (for example: en-US).
TMDB_LANGUAGE=en-US

# Required when NUXT_PUBLIC_ENABLE_MOVIES=true: include adult results in TMDb responses. Accepted values: true, false.
TMDB_INCLUDE_NSFW=false

# Required when NUXT_PUBLIC_ENABLE_MUSICS=true: Spotify client ID.
SPOTIFY_CLIENT_ID=

# Required when NUXT_PUBLIC_ENABLE_MUSICS=true: Spotify client secret. Do not commit real credentials.
SPOTIFY_CLIENT_SECRET=

# Allow visitors to create accounts. Accepted values: true, false.
NUXT_PUBLIC_ALLOW_REGISTRATION=false

# Enable the movies feature. Accepted values: true, false.
NUXT_PUBLIC_ENABLE_MOVIES=true

# Enable the series feature. Accepted values: true, false. Series pages are not currently implemented.
NUXT_PUBLIC_ENABLE_SERIES=false

# Enable the music feature. Accepted values: true, false. Music pages are not currently implemented.
NUXT_PUBLIC_ENABLE_MUSICS=false

# Enable the books feature. Accepted values: true, false. Books pages are not currently implemented.
NUXT_PUBLIC_ENABLE_BOOKS=false

# Enable the games feature. Accepted values: true, false. Games pages are not currently implemented.
NUXT_PUBLIC_ENABLE_GAMES=false
