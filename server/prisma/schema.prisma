generator client {
    provider               = "prisma-client"
    output                 = "../../lib/prisma"
    engineType             = "client"
    moduleFormat           = "esm"
    runtime                = "nodejs"
    generatedFileExtension = "ts"
    importFileExtension    = "ts"
    previewFeatures        = ["strictUndefinedChecks", "partialIndexes"]
}

datasource db {
    provider = "postgresql"
}

enum Role {
    ADMIN
    USER
}

enum MediaType {
    MOVIE
    SERIES
    BOOK
    MUSIC
    GAME
}

model User {
    id           String   @id @default(uuid()) @db.Uuid
    username     String   @unique @db.VarChar(255)
    passwordHash String   @db.VarChar(255)
    role         Role
    createdAt    DateTime @default(now()) @db.Timestamptz(6)
    updatedAt    DateTime @updatedAt @db.Timestamptz(6)

    sessions    Session[]
    collections Collection[]
    medias      Media[]
}

model Session {
    id        String   @id @default(uuid()) @db.Uuid
    sessionId String   @unique @db.VarChar(255)
    userId    String   @db.Uuid
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now()) @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @db.Timestamptz(6)
    expiresAt DateTime @db.Timestamptz(6)
}

model Collection {
    id          String   @id @default(uuid()) @db.Uuid
    name        String   @db.VarChar(255)
    description String?  @db.VarChar(500)
    favorite    Boolean  @default(false) @db.Boolean
    ownerId     String   @db.Uuid
    owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    createdAt   DateTime @default(now()) @db.Timestamptz(6)
    updatedAt   DateTime @updatedAt @db.Timestamptz(6)

    medias CollectionMedia[]
}

model Media {
    id         String    @id @default(uuid()) @db.Uuid
    type       MediaType
    externalId String?   @db.VarChar(255)
    name       String?   @db.VarChar(255)
    imagePath  String?   @db.VarChar(500)
    rating     Float?    @db.DoublePrecision
    ownerId    String    @db.Uuid
    owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    createdAt  DateTime  @default(now()) @db.Timestamptz(6)
    updatedAt  DateTime  @updatedAt @db.Timestamptz(6)

    movie       Movie?
    collections CollectionMedia[]

    @@unique([externalId, ownerId], where: { externalId: { not: null } })
}

model Movie {
    id       String  @id @default(uuid()) @db.Uuid
    overview String? @db.Text
    mediaId  String  @unique @db.Uuid
    media    Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

model CollectionMedia {
    collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
    collectionId String     @db.Uuid
    media        Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
    mediaId      String     @db.Uuid
    addedAt      DateTime   @default(now()) @db.Timestamptz(6)

    @@id([collectionId, mediaId])
}
