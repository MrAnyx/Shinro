generator client {
    provider               = "prisma-client"
    output                 = "../../lib/prisma"
    engineType             = "client"
    moduleFormat           = "esm"
    runtime                = "nodejs"
    generatedFileExtension = "ts"
    importFileExtension    = "ts"
    previewFeatures        = ["strictUndefinedChecks", "partialIndexes"]
}

datasource db {
    provider = "postgresql"
}

enum Role {
    ADMIN
    USER
}

enum MediaType {
    MOVIE
    SERIE
    SEASON
    EPISODE
    BOOK
    MUSIC
    GAME
}

enum MediaStatus {
    PLANNED
    IN_PROGRESS
    DROPPED
    ON_HOLD
    COMPLETED
}

enum ImageType {
    TMDB
}

model User {
    id           String   @id @default(uuid()) @db.Uuid
    username     String   @unique @db.VarChar(255)
    passwordHash String   @db.VarChar(255)
    role         Role
    createdAt    DateTime @default(now()) @db.Timestamptz(6)
    updatedAt    DateTime @updatedAt @db.Timestamptz(6)

    sessions    Session[]
    collections Collection[]
    medias      Media[]
}

model Session {
    id        String   @id @default(uuid()) @db.Uuid
    sessionId String   @unique @db.VarChar(255)
    userId    String   @db.Uuid
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now()) @db.Timestamptz(6)
    updatedAt DateTime @updatedAt @db.Timestamptz(6)
    expiresAt DateTime @db.Timestamptz(6)
}

model Collection {
    id          String   @id @default(uuid()) @db.Uuid
    name        String   @db.VarChar(255)
    description String?  @db.VarChar(500)
    favorite    Boolean  @default(false) @db.Boolean
    ownerId     String   @db.Uuid
    owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    createdAt   DateTime @default(now()) @db.Timestamptz(6)
    updatedAt   DateTime @updatedAt @db.Timestamptz(6)

    medias CollectionMedia[]
}

model Media {
    id         String       @id @default(uuid()) @db.Uuid
    type       MediaType
    status     MediaStatus?
    externalId String?      @db.VarChar(255)
    name       String?      @db.VarChar(255)
    imagePath  String?      @db.VarChar(500)
    imageType  ImageType?
    rating     Float?       @db.DoublePrecision
    note       String?      @db.VarChar(1000)
    ownerId    String       @db.Uuid
    owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    createdAt  DateTime     @default(now()) @db.Timestamptz(6)
    updatedAt  DateTime     @updatedAt @db.Timestamptz(6)

    movie       Movie?
    serie       Serie?
    season      Season?
    episode     Episode?
    collections CollectionMedia[]

    @@unique([externalId, ownerId], where: { externalId: { not: null } })
}

model CollectionMedia {
    collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
    collectionId String     @db.Uuid
    media        Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
    mediaId      String     @db.Uuid
    addedAt      DateTime   @default(now()) @db.Timestamptz(6)

    @@id([collectionId, mediaId])
}

model Movie {
    id       String  @id @db.Uuid
    overview String? @db.Text
    media    Media   @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Serie {
    id       String  @id @db.Uuid
    overview String? @db.Text
    media    Media   @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Season {
    id       String  @id @db.Uuid
    overview String? @db.Text
    media    Media   @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Episode {
    id       String  @id @db.Uuid
    overview String? @db.Text
    media    Media   @relation(fields: [id], references: [id], onDelete: Cascade)
}
